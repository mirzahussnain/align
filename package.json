{
  "name": "align-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:golden-cvs": "vitest run src/shared/stage4/generate-golden.test.ts",
    "test:stage4": "vitest run src/shared/stage4 src/app/api/cv/__tests__/from-profile.test.ts src/app/api/cv/__tests__/regenerate.test.ts",
    "typecheck": "tsc --noEmit",
    "check:env": "node --experimental-strip-types --no-warnings scripts/check-env.mts",
    "check:env:live": "node --experimental-strip-types --no-warnings scripts/check-env.mts --live",
    "dev:up": "docker compose up -d && docker compose up -d --wait db minio redis",
    "dev:down": "docker compose down",
    "dev:nuke": "docker compose down -v",
    "redis:up": "docker compose up -d --wait redis",
    "redis:down": "docker compose stop redis",
    "redis:ping": "docker compose exec redis redis-cli ping",
    "redis:keys": "docker compose exec redis redis-cli --scan --pattern \"align:*\"",
    "redis:flush": "docker compose exec redis redis-cli flushall",
    "test:redis": "vitest run src/shared/lib/cache/__tests__/redis-cache-store.integration.test.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:nuke": "docker compose down -v",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:setup": "npm run dev:up && prisma migrate deploy && prisma generate",
    "esco:import": "node --env-file=.env.local --experimental-strip-types --no-warnings scripts/esco-import.mts",
    "db:seed": "node --env-file=.env.local --experimental-strip-types --no-warnings prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1089.0",
    "@aws-sdk/s3-request-presigner": "^3.1089.0",
    "@google/genai": "^2.7.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "better-auth": "^1.6.23",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "framer-motion": "^12.40.0",
    "groq-sdk": "^1.2.1",
    "ioredis": "^5.11.1",
    "jszip": "^3.10.1",
    "libphonenumber-js": "^1.13.9",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.12.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "recharts": "^3.8.1",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
