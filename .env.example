# Reed API
REED_API_KEY=

# Adzuna API
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble API
JOOBLE_API_KEY=

# GOV.UK Sponsor List CSV URL
GOVUK_SPONSOR_CSV_URL=

# Gemini API Key
GEMINI_API_KEY=

# Groq API Key
GROQ_API_KEY=

# Optional AI runtime tuning (defaults shown)
AI_PROVIDER_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=8192

# Upstash rate limiting (optional locally — rate limiting no-ops if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Job Board cache (Redis)
#
# Backs the provider-result cache, the merged search-response cache, search
# sessions and the distributed refresh lock. Holds NOTHING durable — every key is
# reconstructable by searching again, so losing all of them costs latency and
# nothing else. Saved Jobs, analyses and profiles are unaffected.
#
# Local development: run `npm run redis:up` and use the line below as-is.
REDIS_URL=redis://localhost:6379
#
# UNSET IS A SUPPORTED MODE, not a broken one: the cache resolves to a store
# where every read misses, and search still queries the providers and returns
# results. What is lost is shared caching, shared sessions and the shared refresh
# lock — so searches are slower and "Load more" reports an expired session
# instead of silently repeating page one. A structured warning is emitted once.
#
# This is deliberately NOT the same variable as UPSTASH_REDIS_REST_URL above.
# That one is Upstash's REST endpoint used only by rate limiting; this is a
# redis:// (or rediss://) TCP URL used only by the Job Board cache.

# Postgres (used by Prisma + BetterAuth)
#
# Local development: run `npm run db:setup` and use the line below as-is. It
# points at the docker-compose container (host port 5433, not 5432, so it
# cannot collide with a Postgres already installed on your machine).
DATABASE_URL="postgresql://align:align@localhost:5433/align?schema=public"
#
# Neon (staging/production) instead looks like:
#   DATABASE_URL="postgresql://…@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"
#   DIRECT_URL="postgresql://…@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"
#
# DIRECT_URL is the SAME host with `-pooler` removed. Prisma Migrate uses it for
# DDL and advisory locks, which PgBouncer does not reliably support; the app
# itself keeps using the pooled DATABASE_URL. Leave DIRECT_URL unset locally —
# there is no pooler in front of the container.
DIRECT_URL=

# BetterAuth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Server-only, comma-separated admin allowlist. Empty means no admin access.
# Uses the existing Better Auth identity; it does not create separate credentials.
ADMIN_EMAILS=

# Google OAuth (optional social sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional lifecycle email (optional for non-email local work; required in production)
RESEND_API_KEY=
AUTH_EMAIL_FROM='Align <noreply@align.vyndra.tech>'

# Object storage (S3-compatible)
#
# MinIO locally, Cloudflare R2 in production. Both speak S3, so the application
# never knows which one it is talking to — only these variables change.
#
# Local development: run `npm run dev:up` and use the block below as-is. It
# points at the docker-compose MinIO container, whose buckets are created for
# you on first start.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
# MinIO addresses buckets as <endpoint>/<bucket>/<key>; it cannot do virtual-host
# style without wildcard DNS. R2 is the opposite — leave this false there.
S3_FORCE_PATH_STYLE=true
#
# Cloudflare R2 (staging/production) instead looks like:
#   S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
#   S3_ACCESS_KEY_ID="…"
#   S3_SECRET_ACCESS_KEY="…"
#   S3_REGION=auto            # R2 accepts no other value
#   S3_FORCE_PATH_STYLE=false

# Three buckets, so the two private ones (full of PII) stay isolated from the
# public-read avatar bucket served straight off a CDN. Names match between local
# and production so object keys are identical in both.
# Private: raw CV uploads (PII) — Analysis.sourceFileKey
S3_BUCKET_UPLOADS=align-cv-uploads
# Configure this private bucket with docs/deployment/r2-uploads-cors.json in production.
# Private: generated/tailored CVs — GeneratedCV.fileKey
S3_BUCKET_REWRITES=align-cv-rewrites
# Public-read: profile avatars (avatars/ prefix) — User.image
S3_BUCKET_AVATARS=align-users

# Public base URL for the avatars bucket. Configured rather than derived because
# the providers disagree on shape: MinIO serves from <endpoint>/<bucket>, while
# R2 uses a custom domain or the *.r2.dev URL.
#   Local: http://localhost:9000/align-users
#   R2:    https://avatars.yourdomain.com
S3_PUBLIC_URL_AVATARS=http://localhost:9000/align-users

# Public application origin (checkout return links and lifecycle links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe billing (leave the entire block unset when billing is disabled locally)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_MONTHLY_PRICE_ID=
