# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# testing & artifacts
/artifacts/*
!/artifacts/README.md
/test-results/
/playwright-report/

# local design, editor, and inspection artifacts
/.impeccable/
/.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
/analyze.html
/scratch-count.cjs

# AI tooling & agents
.claude/
.kilo/
.kilocode/
.cursor/

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini

# local docker compose override
docker-compose.override.yml
